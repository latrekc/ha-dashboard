{
  "name": "latrekc-dashboard",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vite build",
    "dev": "vite build --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "fetch:mock": "node --loader ts-node/esm scripts/fetch-mock.ts",
    "dump:tree": "node --loader ts-node/esm scripts/dump-tree.ts",
    "generate:tree": "node --loader ts-node/esm scripts/build-tree.ts",
    "generate:tree:holdout": "node --loader ts-node/esm scripts/build-tree.ts --holdout",
    "generate:trees": "npm run generate:tree && npm run generate:tree:holdout",
    "deploy": "npm run lint && npm run format:check && npm run typecheck && npm run build && scp dist/latrekc-dashboard.js homeassistant:config/www/latrekc/latrekc-dashboard.js",
    "validate": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "test": "jest --config jest.config.cjs",
    "test:watch": "jest --config jest.config.cjs --watch",
    "test:coverage": "jest --config jest.config.cjs --coverage"
  },
  "dependencies": {
    "@hakit/components": "^1.0.0",
    "@hakit/core": "^1.0.0",
    "@mdi/js": "^7.4.47",
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "@storybook/addon-essentials": "8.6.18",
    "@storybook/web-components-vite": "8.6.18",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-lit": "^1.11.0",
    "home-assistant-frontend-types": "^2026.5.2770",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^30.4.1",
    "prettier": "^3.0.0",
    "storybook": "8.6.18",
    "ts-jest": "^29.4.11",
    "ts-node": "^10.9.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
